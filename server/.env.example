PORT=8080
OPENAI_API_KEY=replace-with-your-server-side-key
OPENAI_MODEL=gpt-4o-mini
# Optional additional providers. The Android app selects among these server-side configurations.
ANTHROPIC_API_KEY=replace-with-your-claude-key
ANTHROPIC_MODEL=claude-3-5-haiku-latest
NVIDIA_API_KEY=nvapi-your-nvidia-key
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
SELF_HOSTED_BASE_URL=http://host.docker.internal:8000
SELF_HOSTED_API_KEY=optional-server-side-key
SELF_HOSTED_MODEL=your-coding-model
# Optional: require this header from the Android client.
CURSORAI_CLIENT_TOKEN=replace-with-a-random-token
# Restrict this in production to your app's allowed web origin.
CORS_ORIGIN=*
RATE_LIMIT_PER_MINUTE=30
